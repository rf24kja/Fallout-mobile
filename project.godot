; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

project_name="Wasteland_RPG_Prototype"

[application]

config/name="Wasteland RPG Prototype"
run/main_scene="res://scenes/world/test_map.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[autoload]

EventBus="res://scripts/core/event_bus.gd"
GameManager="res://scripts/core/game_manager.gd"
SaveSystem="res://scripts/core/save_system.gd"
InteractionManager="res://scripts/systems/interaction.gd"
ItemDatabase="res://scripts/systems/item_database.gd"
Inventory="res://scripts/systems/inventory.gd"
DialogueManager="res://scripts/systems/dialogue_manager.gd"
CombatSystem="res://scripts/systems/combat_system.gd"
CharacterSystem="res://scripts/systems/character_system.gd"
CoverSystem="res://scripts/systems/cover_system.gd"
Constants="res://scripts/core/constants.gd"
StageBTestRunner="res://tests/stage_b_test_runner.gd"
StageCTestRunner="res://tests/stage_c_test_runner.gd"
QuestManager="res://scripts/quest_manager.gd"
CombatHUD="res://scripts/ui/combat_hud.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[inputdevices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
2d/default_canvas_item_texture_filter="nearest"
2d/default_canvas_item_texture_repeat="disabled"

[run]

main_scene="res://scenes/world/test_map.tscn"
